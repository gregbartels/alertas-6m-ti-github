[Unit]
Description=Bot de WhatsApp (Baileys) para alertas de 6m TI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ajusta el usuario y las rutas a donde copiaste los archivos en tu Raspberry Pi
User=pi
WorkingDirectory=/home/pi/alertas-6m/whatsapp_bot
Environment=GROUP_JID=PON_AQUI_EL_ID_DEL_GRUPO@g.us
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
